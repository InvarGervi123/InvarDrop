{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvarDrop",
  "version": "0.1.0-beta.1",
  "identifier": "io.github.invargervi.invardrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/prepare-packaging.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "InvarDrop",
        "width": 720,
        "height": 520,
        "minWidth": 360,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "shortDescription": "Simple, private LAN file sharing",
    "publisher": "Invar Gervi",
    "category": "Utility",
    "homepage": "https://github.com/InvarGervi123/InvarDrop",
    "longDescription": "Private, account-free file and folder sharing over the local network. Trusted devices, explicit receiver approval, verified streaming and resumable transfers. Optional audio conversion uses a separately selected FFmpeg executable; FFmpeg is not bundled.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../docs/packaging.md": "PACKAGING.md"
    },
    "createUpdaterArtifacts": false
  }
}
