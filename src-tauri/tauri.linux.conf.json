{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/io.github.invargervi.invardrop.metainfo.xml": "packaging/io.github.invargervi.invardrop.metainfo.xml"
        }
      },
      "deb": {
        "section": "net",
        "priority": "optional",
        "desktopTemplate": "packaging/invardrop.desktop",
        "depends": [
          "libc6 (>= 2.39)"
        ],
        "recommends": [
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/share/doc/invar-drop/copyright": "../LICENSE",
          "/usr/share/metainfo/io.github.invargervi.invardrop.metainfo.xml": "packaging/io.github.invargervi.invardrop.metainfo.xml"
        }
      }
    }
  }
}
